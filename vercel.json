{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.js": {
      "includeFiles": "{lib/og/fonts/**,assets/brand/**,data/*.json,node_modules/harfbuzzjs/**,node_modules/yoga-layout/**}"
    }
  },
  "rewrites": [
    {
      "source": "/qrcity",
      "destination": "/qr-reveals/city/index.html"
    },
    {
      "source": "/qrcity/",
      "destination": "/qr-reveals/city/index.html"
    },
    {
      "source": "/qrarena",
      "destination": "/qr-reveals/arena/index.html"
    },
    {
      "source": "/qrarena/",
      "destination": "/qr-reveals/arena/index.html"
    },
    {
      "source": "/((?!api/|qr-reveals/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/matchups",
      "destination": "/goals-allowed",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/qrcity",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/qrarena",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
